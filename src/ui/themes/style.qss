/* One stylesheet for every theme. ${name} placeholders come from the
   theme's token file; derived tokens (border, muted, hover, pressed,
   accenttext) are computed from them. */

QMainWindow, QDialog {
    background: ${window};
}

QWidget {
    color: ${text};
}

QMenuBar, QMenu {
    background: ${panel};
    color: ${text};
}
QMenu::item:selected, QMenuBar::item:selected {
    background: ${accent};
    color: ${accenttext};
}

QGroupBox {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius}px;
    margin-top: 1.4em;
    padding: 8px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: ${muted};
}

QFrame#sidePanel, QFrame#bottomPanel, QFrame#statsStrip {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius}px;
}

QLabel#panelLabel, QLabel#statKey {
    color: ${muted};
}

QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox, QKeySequenceEdit, QPlainTextEdit, QTextEdit, QListWidget {
    background: ${window};
    border: 1px solid ${border};
    border-radius: ${radius}px;
    padding: 3px 6px;
    selection-background-color: ${accent};
    selection-color: ${accenttext};
}
QComboBox:disabled, QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: ${muted};
}

/* Spin box buttons: once the frame is styled, Qt draws unstyled buttons as
   slivers with no arrows, so they get a full style here. */
QAbstractSpinBox {
    padding-right: 24px;
}
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border-left: 1px solid ${border};
    background: ${panel};
}
QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: ${radius}px;
    border-bottom: 1px solid ${border};
}
QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: ${radius}px;
}
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background: ${hover};
}
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    background: ${pressed};
}
QAbstractSpinBox::up-arrow {
    image: url("${arrowup}");
    width: 9px;
    height: 6px;
}
QAbstractSpinBox::down-arrow {
    image: url("${arrowdown}");
    width: 9px;
    height: 6px;
}
QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::up-arrow:off {
    image: url("${arrowupoff}");
}
QAbstractSpinBox::down-arrow:disabled, QAbstractSpinBox::down-arrow:off {
    image: url("${arrowdownoff}");
}

QComboBox {
    padding-right: 26px;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid ${border};
    border-top-right-radius: ${radius}px;
    border-bottom-right-radius: ${radius}px;
}
QComboBox::drop-down:hover {
    background: ${hover};
}
QComboBox::down-arrow {
    image: url("${arrowdown}");
    width: 9px;
    height: 6px;
}
QComboBox::down-arrow:disabled {
    image: url("${arrowdownoff}");
}
QComboBox QAbstractItemView {
    background: ${panel};
    selection-background-color: ${accent};
    selection-color: ${accenttext};
}

QPushButton {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius}px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: ${hover};
}
QPushButton:pressed {
    background: ${pressed};
}
QPushButton:disabled {
    color: ${muted};
}
QPushButton#captureButton {
    background: ${accent};
    color: ${accenttext};
    font-weight: bold;
    border: none;
    padding: 10px 18px;
}
QPushButton#captureButton:disabled {
    background: ${border};
    color: ${muted};
}
QPushButton#captureButton[capturing="true"] {
    background: #D73A49;
    color: #FFFFFF;
}

QSlider::groove:horizontal {
    height: 4px;
    background: ${border};
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: ${accent};
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}
QSlider::sub-page:horizontal {
    background: ${accent2};
    border-radius: 2px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: ${accent};
    border: 1px solid ${accent};
    border-radius: 3px;
}

QTabWidget::pane {
    border: 1px solid ${border};
    border-radius: ${radius}px;
    background: ${panel};
}
QTabBar::tab {
    background: ${window};
    border: 1px solid ${border};
    padding: 5px 12px;
    border-top-left-radius: ${radius}px;
    border-top-right-radius: ${radius}px;
}
QTabBar::tab:selected {
    background: ${panel};
    color: ${accent};
}

QFrame#banner {
    background: #3D2E00;
    border: 1px solid #D29922;
    border-radius: ${radius}px;
}
QFrame#banner QLabel {
    color: #F2CC60;
}

QToolTip {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border};
}

/* UinDub: the one big action on a tab (Analyze, Render). */
QPushButton#primaryButton {
    background: ${accent};
    color: ${accenttext};
    font-weight: bold;
    border: none;
    padding: 8px 16px;
}
QPushButton#primaryButton:disabled {
    background: ${border};
    color: ${muted};
}
QPushButton#primaryButton[running="true"] {
    background: #D73A49;
    color: #FFFFFF;
}
QLabel#note {
    color: ${muted};
}
QLabel#warn {
    color: #D29922;
}
QDockWidget::title {
    background: ${panel};
    padding: 4px;
}
